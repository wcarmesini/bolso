# Copie para .env e ajuste. Em desenvolvimento nada aqui é obrigatório:
# sem DATABASE_URL a API usa o PGlite (Postgres embutido, em .data/pglite).

# Banco em produção
# DATABASE_URL=postgres://usuario:senha@localhost:5432/bolso

# Endereço público do app (web e API no mesmo domínio)
PUBLIC_URL=http://localhost:5173

# Abrindo pelo celular com túnel (ngrok): troque o PUBLIC_URL pelo endereço https do túnel,
# mantenha o localhost na lista de origens confiáveis e rode o Vite com o mesmo domínio:
#   PUBLIC_URL=https://SEU-DOMINIO.ngrok-free.app
#   TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
#   BOLSO_TUNNEL_HOST=SEU-DOMINIO.ngrok-free.app pnpm dev
# O endereço https também precisa estar no Google Cloud, em URIs de redirecionamento:
#   https://SEU-DOMINIO.ngrok-free.app/api/auth/callback/google

# Obrigatórios em produção
# BETTER_AUTH_SECRET=  (32+ caracteres; gere com: openssl rand -base64 32)
# ENCRYPTION_KEY=      (64 caracteres hexadecimais; gere com: openssl rand -hex 32)

# Login social: cada provedor liga quando as duas variáveis dele existirem.
#
# Google (https://console.cloud.google.com → APIs e serviços → Credenciais):
#   tipo "ID do cliente OAuth" → Aplicativo da Web
#   Origens JavaScript autorizadas:  http://localhost:5173
#   URI de redirecionamento:         http://localhost:5173/api/auth/callback/google
#   (em produção, troque por https://SEU-DOMINIO e o mesmo caminho /api/auth/callback/google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
